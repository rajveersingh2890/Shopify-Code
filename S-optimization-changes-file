<script>
  (() => {
    try {
      const loadVideo = (video) => {
        const source = video.querySelector('source');
        if (source && source.dataset.src) {
          source.src = source.dataset.src; // Load the actual video source
          video.load(); // Load the video
        }
      };

      const handleMouseMove = () => {
        document.removeEventListener('mousemove', handleMouseMove); // Remove the listener after the first move
        document.querySelectorAll('video').forEach(loadVideo);
      };

      const loadAfterDelay = () => {
        document.querySelectorAll('video').forEach(loadVideo);
      };

      // Modify all video tags dynamically
      const processVideos = () => {
        document.querySelectorAll('video').forEach((video) => {
          if (!video.dataset.lazyProcessed) {
            video.dataset.lazyProcessed = "true"; // Mark as processed
            video.preload = 'none'; // Disable preloading
            const source = video.querySelector('source');
            if (source && source.src) {
              source.dataset.src = source.src; // Save the source URL
              source.removeAttribute('src'); // Remove the `src` to prevent loading
            }
          }
        });
      };

      // Observe DOM mutations to find video tags dynamically added
      new MutationObserver((mutations) => {
        mutations.forEach(({ addedNodes }) => {
          addedNodes.forEach((node) => {
            if (node.tagName === 'VIDEO') {
              processVideos();
            }
          });
        });
      }).observe(document.documentElement, {
        childList: true,
        subtree: true
      });

      // Process existing videos on the page
      processVideos();

      // Delay loading videos by 7 seconds
      setTimeout(loadAfterDelay, 7000);

      // Attach mousemove listener to load videos on mouse movement
      document.addEventListener('mousemove', handleMouseMove);
    } catch (error) {
      console.error("Error in lazy loading video:", error);
    }
  })();
</script>


